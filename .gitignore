# macOS
.DS_Store
._*

# Windows
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# LEGO SPIKE app scratch files — keep exported .llsp3 in code/spike-projects/
*.llsp3.bak
~$*

# Large media: put raw video in shared cloud storage, link to it instead.
# Committing 4K match footage will make this repo painful to clone.
*.mov
*.mp4
*.avi

# Presentation exports that can be regenerated
*.pptx.tmp

# FIRST's copyrighted season materials. This repo is public (GitHub Pages
# requires it on the free tier), so NONE of it may be committed.
#
# Allowlist, not blocklist: ignore everything in that folder except our own
# README. Listing extensions to block is fragile — the download included
# .pptx, .mp4, .llsp3 and extensionless files nobody would think to list.
docs/official-materials/*
!docs/official-materials/README.md

# MkDocs build output — the site is built by CI, not committed
site/
.cache/

# Python virtualenv, if you preview the site locally
.venv/
venv/
__pycache__/
